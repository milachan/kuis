APP_NAME="TIK Mission"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Token aman untuk identitas kelompok siswa. WAJIB diganti di produksi.
STUDENT_TOKEN_SALT="ganti-dengan-string-acak-panjang"

# ============================ Akun Guru (seeder) ============================
# Dipakai oleh "php artisan db:seed". JANGAN pakai password bawaan seperti
# "password" — siswa bisa melihat kode guru. Bila TEACHER_PASSWORD kosong,
# seeder membuat password acak kuat dan menampilkannya sekali di layar.
TEACHER_NAME="Guru TIK"
TEACHER_EMAIL=admin@example.com
TEACHER_PASSWORD=

# Batas maksimal upload bukti (KB) => 10240 KB = 10 MB
UPLOAD_MAX_KB=10240

# ======================= Penilaian Otomatis AI (DeepSeek) =======================
# Tempel API key DeepSeek di sini. Ambil dari https://platform.deepseek.com
# Kosongkan (atau AI_REVIEW_ENABLED=false) bila tidak ingin memakai AI;
# aplikasi tetap berjalan dan kiriman menunggu validasi guru seperti biasa.
AI_REVIEW_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT=10
# Bobot XP dari skor AI (persen). 70 => skor AI 80 memberi 70% x 80% dari XP misi.
# Bobot XP dari game arcade diatur di config/tikmission.php (GAME_XP_WEIGHT_PERCENT).
AI_XP_WEIGHT_PERCENT=70

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
